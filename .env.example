# Application
NEWS_RAG_ENV=development
NEWS_RAG_LOG_LEVEL=INFO
NEWS_RAG_STRUCTURED_LOGS=0
NEWS_RAG_INTERVAL_SECONDS=86400
# Optional Streamlit in-app schedule. Leave empty for manual ingestion only.
NEWS_RAG_AUTO_INGEST_SECONDS=
NEWS_RAG_DATA_DIR=data
NEWS_RAG_VECTOR_STORE_DIR=data/chroma
NEWS_RAG_VECTOR_BACKEND=json

# Comma-separated RSS URLs. When empty, development defaults use verified publisher RSS feeds.
NEWS_RAG_TECHNOLOGY_RSS_URLS=
NEWS_RAG_FINANCE_RSS_URLS=
NEWS_RAG_POLITICS_RSS_URLS=
NEWS_RAG_STOCKS_RSS_URLS=
NEWS_RAG_TECHNOLOGY_APPROVED_RSS_URLS=
NEWS_RAG_FINANCE_APPROVED_RSS_URLS=
NEWS_RAG_POLITICS_APPROVED_RSS_URLS=
NEWS_RAG_STOCKS_APPROVED_RSS_URLS=

# Optional LLM settings (not currently wired into answer generation)
NEWS_RAG_LLM_PROVIDER=
NEWS_RAG_LLM_MODEL=

# Embeddings: defaults to sentence-transformers; falls back to hash if the package is missing.
NEWS_RAG_EMBEDDING_PROVIDER=sentence-transformers
NEWS_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
