# Application
NEWS_RAG_ENV=development
NEWS_RAG_LOG_LEVEL=INFO
NEWS_RAG_INTERVAL_SECONDS=86400
NEWS_RAG_DATA_DIR=data
NEWS_RAG_VECTOR_STORE_DIR=data/chroma

# Comma-separated RSS URLs. When empty, development defaults use Google News RSS searches.
NEWS_RAG_TECHNOLOGY_RSS_URLS=
NEWS_RAG_FINANCE_RSS_URLS=
NEWS_RAG_POLITICS_RSS_URLS=
NEWS_RAG_TECHNOLOGY_APPROVED_RSS_URLS=
NEWS_RAG_FINANCE_APPROVED_RSS_URLS=
NEWS_RAG_POLITICS_APPROVED_RSS_URLS=

# Optional provider settings for later phases
NEWS_RAG_LLM_PROVIDER=
NEWS_RAG_LLM_MODEL=
NEWS_RAG_EMBEDDING_PROVIDER=
NEWS_RAG_EMBEDDING_MODEL=
